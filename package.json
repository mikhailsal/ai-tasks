{
  "name": "ai-tasks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local task state engine with CLI and mobile web interfaces",
  "engines": {
    "node": "24.22.0",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "bin": {
    "ai-tasks": "dist/cli.js"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@js-temporal/polyfill": "0.5.1",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-query-persist-client": "5.104.5",
    "better-sqlite3": "13.0.3",
    "commander": "15.0.0",
    "drizzle-orm": "0.45.4",
    "emoji-regex": "11.0.0",
    "fastify": "5.12.7",
    "idb-keyval": "6.3.0",
    "marked": "18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "scripts": {
    "check:runtime": "node scripts/check-runtime.mjs",
    "db:migrate": "tsup && node dist/migrate.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && tsc -p web/tsconfig.sw.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "build:server": "tsup",
    "build": "tsup && vite build --config web/vite.config.ts",
    "test:functional": "node scripts/run-suite.mjs functional -- node node_modules/vitest/vitest.mjs run --project functional",
    "test:contention": "node scripts/run-suite.mjs contention -- node node_modules/vitest/vitest.mjs run --project contention",
    "test:e2e": "node scripts/run-suite.mjs browser -- node node_modules/@playwright/test/cli.js test",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "bench": "node scripts/run-suite.mjs benchmark -- node scripts/benchmark.mjs",
    "start": "node dist/cli.js serve --all-projects",
    "dev": "node scripts/dev.mjs"
  }
}
