#!/usr/bin/env bash
# Local mirror of the CI static gates. Install once with `npm run hooks:install`.
# Changes reach main only through pull requests, so a direct push to main is refused.
set -euo pipefail

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    echo "pre-push: direct pushes to main are not allowed; push a branch and open a pull request." >&2
    exit 1
  fi
done

if ! command -v shellcheck >/dev/null 2>&1; then
  echo "pre-push: ShellCheck is required. Install it (Debian/Ubuntu: sudo apt install shellcheck)." >&2
  exit 1
fi

cd "$(git rev-parse --show-toplevel)"
npm run --silent check:runtime
npm run --silent typecheck
npm run --silent lint
npm run --silent format:check
shellcheck .githooks/pre-push
